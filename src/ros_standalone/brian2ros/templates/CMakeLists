cmake_minimum_required(VERSION 3.10)
project(brian_project)

# Default to C++14
if(NOT CMAKE_CXX_STANDARD) 
  set(CMAKE_CXX_STANDARD 14) 
endif()

# Set additional compiler options for GCC and Clang
if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang") 
  add_compile_options({{ compiler_flags }}) 
endif()

# Find necessary packages
find_package(ament_cmake REQUIRED)
find_package(rclcpp REQUIRED)
find_package(std_msgs REQUIRED)
find_package(sensor_msgs REQUIRED)
find_package(turtleaudio REQUIRED)
find_package(builtin_interfaces REQUIRED)
find_package(rosidl_default_generators REQUIRED)

set(SRCS {{source_files}})
# Include directories
include_directories(
  ${CMAKE_SOURCE_DIR}
  {{ include_dirs }}
)

set(OPTIMISATIONS {{ compiler_flags }})
add_compile_options(${OPTIMISATIONS})

rosidl_generate_interfaces(${PROJECT_NAME}
  "msg/FloatStateMonitor.msg"
  DEPENDENCIES std_msgs
)
ament_export_dependencies(rosidl_default_runtime)
rosidl_get_typesupport_target(cpp_typesupport_target ${PROJECT_NAME} "rosidl_typesupport_cpp")

# Add executable for the main project
add_executable(main ${SRCS})
target_link_libraries(main
  'portaudio'
  ${cpp_typesupport_target}
)
ament_target_dependencies(main rclcpp std_msgs sensor_msgs turtleaudio)

# Install targets
install(TARGETS
  main
  DESTINATION lib/${PROJECT_NAME}
)

install(PROGRAMS
  main.bash
  DESTINATION lib/${PROJECT_NAME}
)

install(
  DIRECTORY static_arrays
  DESTINATION lib/${PROJECT_NAME}
)

install(
  FILES json/b_control.txt {% if cyclonedds %} cyclone_profile.xml {%endif%}
  DESTINATION lib/${PROJECT_NAME}
)

install(
  DIRECTORY
  DESTINATION lib/${PROJECT_NAME}/results
)
ament_package()